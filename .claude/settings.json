{
  "model": "sonnet",
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*service-role*)",
      "Read(**/id_rsa*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout .)",
      "Bash(supabase db reset:*)",
      "Bash(vercel deploy:*)",
      "Bash(vercel --prod:*)",
      "Bash(npx vercel:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git branch -D:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(supabase:*)",
      "Bash(psql:*)",
      "Edit(./CLAUDE.md)",
      "Edit(./.claude/settings.json)",
      "Edit(**/*.sql)"
    ],
    "allow": [
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash list)",
      "Bash(npm run lint)",
      "Bash(npm run lint:*)",
      "Bash(npm run build)",
      "Bash(npm run typecheck)",
      "Bash(npm run test:*)",
      "Bash(npx tsc:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Read(./src/**)",
      "Read(./docs/**)",
      "Read(./public/**)",
      "Read(./supabase/**)",
      "Read(./scripts/**)",
      "Edit(./src/**)",
      "Edit(./docs/**)",
      "Write(./src/**)",
      "Write(./docs/**)",
      "Task(Explore)",
      "Task(Plan)"
    ]
  }
}
